{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "http://console.redhat.com/platform-logging.schema.json",
    "title": "Event",
    "description": "A log event for collection by the platform-logging service.",
    "type": "object",
    "properties": {
        "@timestamp": {
            "description": "The timestamp of the generated log.",
            "type": "string"
        },
        "labels": {
            "description": "A set of custom key/value pairs for tagging log events.",
            "type": "object",
            "additionalProperties": {
                "type": "string"
            }
        },
        "message": {
            "description": "Human readable log message from the log event.",
            "type": "string"
        },
        "tags": {
            "description": "An array of strings used to tag log event.",
            "type": "array",
            "items": {
                "type": "string"
            }    
        },
        "agent": {
            "description": "Data about the software entity, if any, that collects, detects, or observes events on a host, or takes measurements on a host",
            "type": "object",
            "properties": {
                "build": {
                    "description": "",
                    "type": "object",
                    "properties": {
                        "original": {
                            "description": "Build information for the agent.",
                            "type": "string"
                        }
                    }
                },
                "ephemeral_id": {
                    "description": "Ephemeral id of this agent, if any.",
                    "type": "string"
                },
                "id": {
                    "description": "Unique identifier of this agent, if any.",
                    "type": "string"
                },
                "name": {
                    "description": "Name of this agent.",
                    "type": "string"
                },
                "type": {
                    "description": "Type of the agent.",
                    "type": "string"
                },
                "version": {
                    "description": "Version string for the agent.",
                    "type": "string"
                }
            }
        },
        "cilent": {
            "description": "Information about the initiator of a network connection.",
            "type": "object",
            "properties": {
                "address": {
                    "description": "IP address or URL of the client generating the log event.",
                    "type": "string"
                },
                "bytes": {
                    "description": "Total bytes sent from client to server.",
                    "type": "integer"
                },
                "domain": {
                    "description": "URL of the client generating the log event.",
                    "type": "string"
                },
                "ip": {
                    "description": "IP address of the client generating the log event.",
                    "type": "string"
                },
                "mac": {
                    "description": "MAC address of the client generating the event.",
                    "type": "string"
                },
                "nat": {
                    "description": "Information on the NAT session for the client generating the log event.",
                    "type": "object",
                    "properties": {
                        "ip": {
                            "description": "Translated IP address for source-based NAT.",
                            "type": "string"
                        },
                        "port": {
                            "description": "Translated port for source-based NAT.",
                            "type": "integer"
                        }
                    }
                },
                "packets": {
                    "description": "Count of packets sent from client to server.",
                    "type": "integer"
                },
                "port": {
                    "description": "Port of the client connection.",
                    "type": "integer"
                },
                "registered_domain": {
                    "description": "Highest registered client domain, stripped of subdomains.",
                    "type": "string"
                },
                "subdomain": {
                    "description": "Subdomain of FQDN for client.",
                    "type": "string"
                },
                "top_level_domain": {
                    "description": "Effective TLD or domain suffix for client.",
                    "type": "string"
                }
            }
        },
        "cloud": {
            "description": "Information from the cloud source of the event.",
            "type": "object",
            "properties": {
                "account": {
                    "description": "Cloud account info for the event.",
                    "type": "object",
                    "properties": {
                        "id": {
                            "description": "Cloud account ID for the event.",
                            "type": "string"
                        },
                        "name": {
                            "description": "Cloud account name for the event.",
                            "type": "string"
                        }
                    }
                },
                "availability_zone": {
                    "description": "Availability zone of the host producing the event.",
                    "type": "string"
                },
                "instance": {
                    "description": "Instance information from the host machine.",
                    "type": "object",
                    "properties": {
                        "id": {
                            "description": "Instance ID for the host machine.",
                            "type": "string"
                        },
                        "name": {
                            "description": "Instance name for the host machine.",
                            "type": "string"
                        }
                    }
                },
                "machine": {
                    "description": "Machine information for the host.",
                    "type": "object",
                    "properties": {
                        "type": {
                            "description": "Host machine type.",
                            "type": "string"
                        }
                    }
                },
                "project": {
                    "description": "Cloud project information.",
                    "type": "object",
                    "properties": {
                        "id": {
                            "description": "Cloud project ID.",
                            "type": "string"
                        },
                        "name": {
                            "description": "Cloud project name.",
                            "type": "string"
                        }
                    }
                },
                "provider": {
                    "description": "Cloud provider for this host.",
                    "type": "string"
                },
                "region": {
                    "description": "Cloud region this host runs in.",
                    "type": "string"
                },
                "service": {
                    "description": "Cloud service information.",
                    "type": "object",
                    "properties": {
                        "name": {
                            "description": "Cloud service name, such at EC2 or Lambda, etc.",
                            "type": "string"
                        }
                    }
                }
            }
        },
        "container": {
            "description": "Information about the container that generated the log event.",
            "type": "object",
            "properties": {
                "id": {
                    "description": "Unique id of source container.",
                    "type": "string"
                },
                "image": {
                    "description": "Information on the image for the source container.",
                    "type": "object",
                    "properties": {
                        "name": {
                            "description": "Image name for source container image.",
                            "type": "string"
                        },
                        "tag": {
                            "description": "Image tag for source container image.",
                            "type": "string"
                        }
                    }
                },
                "labels": {
                    "description": "Source container image labels.",
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "name": {
                    "description": "Source container name.",
                    "type": "string"
                },
                "runtime": {
                    "description": "Runtime service for source container [docker, podman, etc].",
                    "type": "string"
                }
            }
        },
        "data_stream": {
            "description": "Information about the event generating data stream.",
            "type": "object",
            "properties": {
                "dataset": {
                    "description": "Field to help signify source of data. Ex. Prometheus, nginx.access, etc",
                    "type": "string"
                },
                "namespace":{
                    "description": "User defined namespace for data source.",
                    "type": "string"
                },
                "type": {
                    "description": "Overarching type for the data stream. Must be 'logs' or 'metrics' currently.",
                    "type": "string",
                    "enum": ["logs", "metrics"]
                }
            }
        },
        "destination": {
            "description": "Information about the receiver of a network exchange.",
            "type": "object",
            "properties": {
                "address": {
                    "description": "Raw address of the destination, be it IP or socket or domain name.",
                    "type": "string"
                },
                "bytes": {
                    "description": "Number of bytes sent from the destination to the source.",
                    "type": "integer"
                },
                "domain": {
                    "description": "Destination domain",
                    "type": "string"
                },
                "ip": {
                    "description": "Destination IP",
                    "type": "string"
                },
                "mac": {
                    "description": "Destination MAC address",
                    "type": "string"
                },
                "nat": {
                    "description": "Information related to NAT of the destination.",
                    "type": "object",
                    "properties": {
                        "ip": {
                            "description": "Translated IP of destination based on NAT session.",
                            "type": "string"
                        },
                        "port": {
                            "description": "Port the source session is translated to by NAT.",
                            "type": "integer"
                        }
                    }
                },
                "packets": {
                    "description": "Number of packets sent from the destination to the source.",
                    "type": "integer"
                },
                "port": {
                    "description": "Port of the destination.",
                    "type": "integer"
                },
                "registered_domain": {
                    "description": "Highest registered destination domain, stripped of subdomain.",
                    "type": "string"
                },
                "subdomain": {
                    "description": "Subdomain portion of FQDN of the destination.",
                    "type": "string"
                },
                "top_level_domain": {
                    "description": "Effective top level domain (eTLD) or domain suffix of the destination.",
                    "type": "string"
                }
            }
        },
        "ecs": {
            "description": "Event data pertaining to the Elastic Common Schema",
            "type": "object",
            "properties": {
                "version": {
                    "description": "The version of the Elastic Common Schema in use.",
                    "type": "string"
                }
            },
            "required": [ "version" ]
        },
        "error": {
            "description": "Information about error log events.",
            "type": "object",
            "properties": {
                "code": {
                    "description": "Error code for the error event",
                    "type": "string"
                },
                "id": {
                    "description": "Unique identifier of the error event.",
                    "type": "string"
                },
                "message": {
                    "description": "Full message from error event.",
                    "type": "string"
                },
                "stack_trace": {
                    "description": "Stack trace for the error in plain text error event.",
                    "type": "string"
                },
                "type": {
                    "description": "The type of the error, exception class name, etc.",
                    "type": "string"
                }
            }
        },
        "http": {
            "description": "Event data pertaining to HTTP activity.",
            "type": "object",
            "properties": {
                "request": {
                    "description": "Information about HTTP requests.",
                    "type": "object",
                    "properties": {
                        "body": {
                            "description": "Information about HTTP request body.",
                            "type": "object",
                            "properties": {
                                "bytes": {
                                    "description": "Size of HTTP request body in bytes.",
                                    "type": "integer"
                                },
                                "content": {
                                    "description": "Full HTTP request body.",
                                    "type": "string"
                                }
                            }
                        },
                        "bytes": {
                            "description": "Size of HTTP request in bytes.",
                            "type": "integer"
                        },
                        "id": {
                            "description": "Unique HTTP request identifier.",
                            "type": "string"
                        },
                        "method": {
                            "description": "HTTP request method.",
                            "type": "string"
                        },
                        "mime_type": {
                            "description": "Mime tyep of HTTP request.",
                            "type": "string"
                        },
                        "referrer": {
                            "description": "Referrer of this HTTP request.",
                            "type": "string"
                        }
                    }
                },
                "response": {
                    "description": "HTTP response event information.",
                    "type": "object",
                    "properties": {
                        "body": {
                            "description": "HTTP response body information.",
                            "type": "object",
                            "properties": {
                                "bytes": {
                                    "description": "Size of HTTP response body in bytes.",
                                    "type": "integer"
                                },
                                "content": {
                                    "description": "Full HTTP response body.",
                                    "type": "string"
                                }
                            }
                        },
                        "bytes": {
                            "description": "Size of HTTP response in bytes.",
                            "type": "integer"
                        },
                        "mime_type": {
                            "description": "Mime tyep of HTTP response.",
                            "type": "string"
                        },
                        "status_code": {
                            "description": "HTTP response status code.",
                            "type": "integer"
                        }
                    }
                },
                "version": {
                    "description": "HTTP version in use.",
                    "type": "string"
                }
            }
        },
        "log": {
            "description": "Information pertaining to the log event itself.",
            "type": "object",
            "properties": {
                "file": {
                    "description": "Log file this event came from, if any.",
                    "type": "object",
                    "properties": {
                        "path": {
                            "description": "Full path to log file this event came from, if any.",
                            "type": "string"
                        }
                    }
                },
                "level": {
                    "description": "Original log level of event.",
                    "type": "string"
                },
                "logger": {
                    "description": "Name of internal application logger generating event.",
                    "type": "string"
                },
                "origin": {
                    "description": "Details on log event origin.",
                    "type": "object",
                    "properties": {
                        "file": {
                            "description": "Details of source code file log event originates from.",
                            "type": "object",
                            "properties": {
                                "line": {
                                    "description": "Line number in source code file that generated the log event.",
                                    "type": "integer"
                                },
                                "name": {
                                    "description": "Name of the file containing the source code that generated the log event.",
                                    "type": "string"
                                }
                            }
                        },
                        "function": {
                            "description": "Name of the function or method that generated the log event.",
                            "type": "string"
                        }
                    }
                },
                "original": {
                    "description": "Full original log message from event source.",
                    "type": "string"
                },
                "syslog": {
                    "description": "Syslog metadata of the event, if applicable.",
                    "type": "object",
                    "properties": {
                        "facility": {
                            "description": "Syslog facility information for log event, if applicable.",
                            "type": "object",
                            "properties": {
                                "code": {
                                    "description": "Numeric syslog facility of log event.",
                                    "type": "integer"
                                },
                                "name": {
                                    "description": "Text-based syslog facility of log event.",
                                    "type": "string"
                                }
                            }
                        },
                        "priority": {
                            "description": "Numeric priority in syslog of log event.",
                            "type": "integer"
                        },
                        "severity": {
                            "description": "Information about syslog severity of log event.",
                            "type": "object",
                            "properties": {
                                "code": {
                                    "description": "Numeric syslog severity of log event.",
                                    "type": "integer"
                                },
                                "name": {
                                    "description": "Textual syslog severity of log event.",
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
        "source": {
            "description": "Information about the sender of a network exchange.",
            "type": "object",
            "properties": {
                "address": {
                    "description": "Raw address of the source, be it IP or socket or domain name.",
                    "type": "string"
                },
                "bytes": {
                    "description": "Number of bytes sent from the source to the destination.",
                    "type": "integer"
                },
                "domain": {
                    "description": "Source domain",
                    "type": "string"
                },
                "ip": {
                    "description": "Source IP",
                    "type": "string"
                },
                "mac": {
                    "description": "Source MAC address",
                    "type": "string"
                },
                "nat": {
                    "description": "Information related to NAT of the Source.",
                    "type": "object",
                    "properties": {
                        "ip": {
                            "description": "Translated IP of source based on NAT session.",
                            "type": "string"
                        },
                        "port": {
                            "description": "Port the source session is translated to by NAT.",
                            "type": "integer"
                        }
                    }
                },
                "packets": {
                    "description": "Number of packets sent from the source to the destination.",
                    "type": "integer"
                },
                "port": {
                    "description": "Port of the source.",
                    "type": "integer"
                },
                "registered_domain": {
                    "description": "Highest registered source domain, stripped of subdomain.",
                    "type": "string"
                },
                "subdomain": {
                    "description": "Subdomain portion of FQDN of the source.",
                    "type": "string"
                },
                "top_level_domain": {
                    "description": "Effective top level domain (eTLD) or domain suffix of the source.",
                    "type": "string"
                }
            }
        },
        "url": {
            "description": "Information pertaining to URLs involved in the event.",
            "type": "object",
            "properties": {
                "domain": {
                    "description": "Domain of the URL.",
                    "type": "string"
                },
                "extension": {
                    "description": "Extention of files from original request URL, if any, excluding leading dot.",
                    "type": "string"
                },
                "fragment": {
                    "description": "Portion of URL after anchor or #.",
                    "type": "string"
                },
                "full": {
                    "description": "Full URL including querystrings, options, params, etc..",
                    "type": "string"
                },
                "original": {
                    "description": "Unmodified URL as seen in event source.",
                    "type": "string"
                },
                "password": {
                    "description": "Password for request, if any.",
                    "type": "string"
                },
                "path": {
                    "description": "Path for the request, such as /search.",
                    "type": "string"
                },
                "port": {
                    "description": "Port of the request.",
                    "type": "integer"
                },
                "query": {
                    "description": "Querystring of the request, if any, not including '?'.",
                    "type": "string"
                },
                "registered_domain": {
                    "description": "The highest registered url domain, stripped of the subdomain.",
                    "type": "string"
                },
                "scheme": {
                    "description": "Scheme of the request, such as https.",
                    "type": "string"
                },
                "subdomain": {
                    "description": "Subdomain portion of the FQDN, everything up to the registered_domain.",
                    "type": "string"
                },
                "top_level_domain": {
                    "description": "Effective top level domain name of the URL, AKA the suffix of the request URL.",
                    "type": "string"
                },
                "username": {
                    "description": "Username of the request, if any.",
                    "type": "string"
                }
            }
        }
    },
    "required": [ "@timestamp", "ecs" ]
}