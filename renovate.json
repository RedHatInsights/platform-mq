{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    ":disableMajorUpdates",
    "github>konflux-ci/mintmaker-presets:cve-automerge-all",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "dockerfile": {
    "managerFilePatterns": [
      "/^Connect/Dockerfile$/"
    ]
  },
  "packageRules": [
    {
      "description": "AMQ Streams base image - stay on 2.9.4-x, manual review",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "registry.redhat.io/amq-streams/kafka-38-rhel9"
      ],
      "versioning": "redhat",
      "allowedVersions": "/^2\\.9\\.4-[0-9]+$/",
      "automerge": false
    }
  ]
}
